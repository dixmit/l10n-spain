<odoo>
    <record model="ir.ui.view" id="stock_picking_form_view">
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="stock_delivery.view_picking_withcarrier_out_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='tracking']" position="inside">
                <button
                    name="button_get_asigna_labels"
                    type="object"
                    string="Get Asigna Labels"
                    invisible="not carrier_tracking_ref or delivery_type != 'asigna' or state != 'done'"
                />
            </xpath>
        </field>
    </record>
</odoo>
